# Matches what CI enforces: black and ruff at 100 columns for Python, and the
# formatting terraform fmt, YAML and Make expect.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 100

[*.{yml,yaml,json,tf,tfvars,hcl}]
indent_size = 2

[Makefile]
indent_style = tab

[*.md]
trim_trailing_whitespace = false
